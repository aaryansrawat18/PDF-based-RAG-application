# LLM: openai | gemini  (this pipeline defaults to OpenAI)
LLM_PROVIDER=openai
OPENAI_API_KEY=
GOOGLE_API_KEY=

# Generate node — medium: gpt-4.1-mini (default)
# Light: gpt-5.4-nano   |  stronger medium: gpt-5.4-mini
OPENAI_MODEL=gpt-4.1-mini
GEMINI_MODEL=gemini-2.0-flash

# Embeddings — light: text-embedding-3-small (default)
# Medium: text-embedding-3-large
EMBEDDING_MODEL=text-embedding-3-small

# Qdrant — leave QDRANT_URL empty to use local embedded storage
QDRANT_URL=
QDRANT_API_KEY=
QDRANT_PATH=vectorstore_db
QDRANT_COLLECTION=rag_chunks

# Chunking
CHUNK_SIZE=800
CHUNK_OVERLAP=150

# Retrieval: hybrid top-20 → rerank top-10 → prune top-5
RETRIEVE_K=20
RERANK_K=10
PRUNE_K=5
RRF_K=60
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
PRUNE_SCORE_THRESHOLD=0.0
PRUNE_OVERLAP_THRESHOLD=0.8
PRUNE_MAX_TOKENS=2000
BM25_CORPUS_PATH=vectorstore_db/bm25_corpus.json

# Data
SOURCE_PDFS_DIR=data/source_pdfs
