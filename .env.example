# LLM: gemini | openai
LLM_PROVIDER=gemini
GOOGLE_API_KEY=
OPENAI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
OPENAI_MODEL=gpt-4o-mini

# Embeddings (sentence-transformers)
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5

# Qdrant — leave QDRANT_URL empty to use local embedded storage
QDRANT_URL=
QDRANT_API_KEY=
QDRANT_PATH=vectorstore_db
QDRANT_COLLECTION=rag_chunks

# Chunking
CHUNK_SIZE=800
CHUNK_OVERLAP=150

# Retrieval
RETRIEVE_K=5

# Data
SOURCE_PDFS_DIR=data/source_pdfs
