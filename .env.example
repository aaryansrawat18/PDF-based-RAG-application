# LLM: openai | gemini  (this pipeline defaults to OpenAI)
LLM_PROVIDER=openai
OPENAI_API_KEY=
GOOGLE_API_KEY=

# Generate node — medium: gpt-4.1-mini (default)
# Light: gpt-5.4-nano   |  stronger medium: gpt-5.4-mini
OPENAI_MODEL=gpt-4.1-mini
REWRITE_MODEL=gpt-5.4-nano
GEMINI_MODEL=gemini-2.0-flash

# Embeddings — light: text-embedding-3-small (default)
# Medium: text-embedding-3-large
EMBEDDING_MODEL=text-embedding-3-small

# Qdrant — leave QDRANT_URL empty to use local embedded storage
QDRANT_URL=
QDRANT_API_KEY=
QDRANT_PATH=vectorstore_db
QDRANT_COLLECTION=rag_chunks

# Chunking
CHUNK_SIZE=800
CHUNK_OVERLAP=150

# Retrieval: hybrid top-20 → rerank top-10 → prune top-5
RETRIEVE_K=20
RERANK_K=10
PRUNE_K=5
RRF_K=60
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
PRUNE_SCORE_THRESHOLD=0.0
PRUNE_OVERLAP_THRESHOLD=0.8
PRUNE_MAX_TOKENS=2000
BM25_CORPUS_PATH=vectorstore_db/bm25_corpus.json

# Phase 6: rewrite + retry
MAX_RETRIEVE_RETRIES=2
MAX_GENERATE_RETRIES=1
CONTEXT_MIN_CHUNKS=1
CONTEXT_SCORE_THRESHOLD=0.5

# Phase 7: OpenAI prompt cache (provider KV-cache, not Redis)
# prompt_cache_key routes requests that share the frozen system prefix.
# prompt_cache_retention: in_memory (5–10 min) or 24h (gpt-4.1 family)
PROMPT_CACHE_KEY=rag-pipeline-v1
PROMPT_CACHE_RETENTION=in_memory

# Phase 7: LangSmith tracing (node spans + token / cache usage)
# tracing.py also sets LANGCHAIN_TRACING_V2 for the LangGraph tracer.
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=rag-pipeline
# LANGSMITH_ENDPOINT=https://api.smith.langchain.com

# Data
SOURCE_PDFS_DIR=data/source_pdfs
